<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:DianxiaoMaui.ViewModels"
             xmlns:model="clr-namespace:DianxiaoMaui.Models"
             x:Class="DianxiaoMaui.Views.Tabs.CustomersPage"
             Title="客户"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <viewmodel:CustomersViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="0">
        <!-- Search Bar -->
        <Frame Style="{StaticResource CardView}" Margin="12,12,12,0" Padding="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                <SearchBar x:Name="SearchBar"
                           Placeholder="搜索姓名/电话/标签"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent"
                           HeightRequest="44"
                           Margin="12,0,0,0" />
                <Button Grid.Column="1"
                        Text="新增"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCustomerCommand}"
                        Margin="0,0,12,0"
                        WidthRequest="70"
                        FontSize="14" />
            </Grid>
        </Frame>

        <!-- Customer List -->
        <CollectionView ItemsSource="{Binding Customers}"
                        SelectionMode="Single"
                        SelectionChangedCommand="{Binding CustomerSelectedCommand}"
                        EmptyView="暂无客户，点击右上角新增"
                        Margin="12,8,12,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Customer">
                    <Frame Style="{StaticResource CardView}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <!-- Avatar -->
                            <Frame Grid.RowSpan="2"
                                   WidthRequest="44" HeightRequest="44"
                                              BackgroundColor="{StaticResource PrimaryColor}"
                                   HasShadow="False"
                                   VerticalOptions="Center"
                                   Margin="0,0,0,0">
                                <Label Text="{Binding Name, Converter={StaticResource FirstCharConverter}}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>

                            <!-- Name & Phone -->
                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimaryColor}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Grid.Row="1"
                                   Text="{Binding DisplayPhone}"
                                   FontSize="13"
                                   TextColor="{StaticResource TextSecondaryColor}"
                                   VerticalOptions="Center" />

                            <!-- Tags & Intent -->
                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="2" Spacing="4" HorizontalOptions="End">
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding TagList}" Spacing="4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="{Binding .}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource PrimaryColor}"
                                                   BackgroundColor="{StaticResource PrimaryColor}"
                                                   Padding="6,2"
                                                   Opacity="0.15"
                                                   />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                                <Label Text="{Binding IntentText}"
                                       FontSize="11"
                                       TextColor="{Binding IntentColor}"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>