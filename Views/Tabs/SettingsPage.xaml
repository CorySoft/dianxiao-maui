<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DianxiaoMaui.Views.Tabs.SettingsPage"
             Title="设置"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12,12,12,24">

            <!-- 无障碍引导 -->
            <Frame Style="{StaticResource CardView}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="无障碍服务" Style="{StaticResource SectionTitle}" />
                    <Label Text="自动拨号需开启本应用的无障碍服务，用于自动点击拨号界面的“呼叫”按钮。"
                           FontSize="13" TextColor="{StaticResource TextSecondaryColor}" />
                    <Button Text="开启无障碍服务"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnOpenAccessibility" />
                </VerticalStackLayout>
            </Frame>

            <!-- 拨号相关 -->
            <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="拨号设置" Style="{StaticResource SectionTitle}" Padding="16,16,16,8" />
                    <StackLayout>
                        <StackLayout.Children>
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="拨号设置" FontSize="15"
                                       TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDialSettings" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="双卡前缀" FontSize="15"
                                       TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrefixSettings" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="黑名单" FontSize="15"
                                       TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBlacklist" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </StackLayout.Children>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- 数据 -->
            <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="数据与统计" Style="{StaticResource SectionTitle}" Padding="16,16,16,8" />
                    <StackLayout>
                        <StackLayout.Children>
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="通话记录" FontSize="15"
                                       TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistory" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="统计报表" FontSize="15"
                                       TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                                <Image Grid.Column="1" Source="ic_chevron.png" WidthRequest="16" HeightRequest="16" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReport" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </StackLayout.Children>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- 云端服务（敬请期待） -->
            <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="云端服务" Style="{StaticResource SectionTitle}" Padding="16,16,16,8" />
                    <StackLayout>
                        <StackLayout.Children>
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="云端备份" FontSize="15"
                                       TextColor="{StaticResource TextSecondaryColor}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="敬请期待" FontSize="12" TextColor="{StaticResource PlaceholderColor}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnComingSoon" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="账号" FontSize="15"
                                       TextColor="{StaticResource TextSecondaryColor}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="敬请期待" FontSize="12" TextColor="{StaticResource PlaceholderColor}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnComingSoon" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="会员中心" FontSize="15"
                                       TextColor="{StaticResource TextSecondaryColor}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="敬请期待" FontSize="12" TextColor="{StaticResource PlaceholderColor}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnComingSoon" />
                                </Grid.GestureRecognizers>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12">
                                <Label Grid.Column="0" Text="AI智能分析" FontSize="15"
                                       TextColor="{StaticResource TextSecondaryColor}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="敬请期待" FontSize="12" TextColor="{StaticResource PlaceholderColor}" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnComingSoon" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </StackLayout.Children>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- 关于 -->
            <Frame Style="{StaticResource CardView}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="关于" Style="{StaticResource SectionTitle}" />
                    <Label Text="电销自动拨号 v1.0" FontSize="14" TextColor="{StaticResource TextPrimaryColor}" />
                    <Label Text="离线版 · 基于 .NET MAUI 实现" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>