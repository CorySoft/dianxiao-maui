<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:DianxiaoMaui.ViewModels"
             x:Class="DianxiaoMaui.Views.Features.ReportPage"
             Title="统计报表"
             Shell.NavBarIsVisible="True">

    <ContentPage.BindingContext>
        <viewmodel:ReportViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12,12,12,24">

            <Frame Style="{StaticResource CardView}" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="通话概览" Style="{StaticResource SectionTitle}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding Total}" Style="{StaticResource StatNum}" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{Binding Connected}" Style="{StaticResource StatNum}" />
                        <Label Grid.Column="2" Grid.Row="0" Text="{Binding Unconnected}" Style="{StaticResource StatNum}" />

                        <Label Grid.Column="0" Grid.Row="1" Text="总通话" Style="{StaticResource StatLabel}" />
                        <Label Grid.Column="1" Grid.Row="1" Text="已接通" Style="{StaticResource StatLabel}" />
                        <Label Grid.Column="2" Grid.Row="1" Text="未接通" Style="{StaticResource StatLabel}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Label Grid.Column="0" Grid.Row="0" Text="{Binding TotalDurationText}" Style="{StaticResource StatNum}" />
                        <Label Grid.Column="1" Grid.Row="0" Text="{Binding ConnectionRate, StringFormat='{0:P0}'}" Style="{StaticResource StatNum}" />

                        <Label Grid.Column="0" Grid.Row="1" Text="总时长" Style="{StaticResource StatLabel}" />
                        <Label Grid.Column="1" Grid.Row="1" Text="接通率" Style="{StaticResource StatLabel}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardView}" Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="说明" Style="{StaticResource SectionTitle}" />
                    <Label Text="以上统计基于本地通话记录，仅统计已完成的自动/手动外呼。"
                           FontSize="13" TextColor="{StaticResource TextSecondaryColor}" />
                    <Label Text="云端报表（按日期/坐席/标签多维分析）敬请期待。"
                           FontSize="13" TextColor="{StaticResource TextSecondaryColor}" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>