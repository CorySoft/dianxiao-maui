<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:DianxiaoMaui.ViewModels"
             xmlns:model="clr-namespace:DianxiaoMaui.Models"
             x:Class="DianxiaoMaui.Views.Features.BlacklistPage"
             Title="黑名单"
             Shell.NavBarIsVisible="True">

    <ContentPage.BindingContext>
        <viewmodel:BlacklistViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="12" Padding="12,12,12,24">

        <Frame Style="{StaticResource CardView}" Padding="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" Text="{Binding NewPhone, Mode=TwoWay}"
                       Placeholder="输入要屏蔽的号码"
                       Style="{StaticResource EntryStyle}" />
                <Button Grid.Column="1" Text="添加" Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}" HeightRequest="44" WidthRequest="80" />
            </Grid>
        </Frame>

        <CollectionView ItemsSource="{Binding Blacklist}"
                        EmptyView="暂无黑名单号码"
                        Margin="12,0,12,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Blacklist">
                    <Frame Style="{StaticResource CardView}" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding MaskedNumber}" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="删除" Style="{StaticResource DangerButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodel:BlacklistViewModel}}, Path=RemoveCommand}"
                                    CommandParameter="{Binding .}" FontSize="12" HeightRequest="32" WidthRequest="60" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>