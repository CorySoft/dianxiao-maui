<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:DianxiaoMaui.ViewModels"
             x:Class="DianxiaoMaui.Views.Features.DialSettingsPage"
             Title="拨号设置"
             Shell.NavBarIsVisible="True">

    <ContentPage.BindingContext>
        <viewmodel:DialSettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="12" Padding="12,12,12,24">

            <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="通用设置" Style="{StaticResource SectionTitle}" Padding="16,16,16,8" />

                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="两次外呼间隔（秒）" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding IntervalSec, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="80" HeightRequest="40"
                                   BackgroundColor="{StaticResource PageBackgroundColor}"
                                   TextColor="{StaticResource TextPrimaryColor}" FontSize="14"
                                   HorizontalTextAlignment="End" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="每次外呼完成后等待的秒数，防止频繁呼叫被运营商限制"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14">
                            <Label Grid.Column="0" Text="通话界面包名" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding IncallPackage, Mode=TwoWay}"
                                   WidthRequest="200" HeightRequest="40"
                                   BackgroundColor="{StaticResource PageBackgroundColor}"
                                   TextColor="{StaticResource TextPrimaryColor}" FontSize="14"
                                   HorizontalTextAlignment="End" Margin="0,0,12,0" />
                        </Grid>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="自动化" Style="{StaticResource SectionTitle}" Padding="16,16,16,8" />

                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="自动免提" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding AutoSpeaker, Mode=TwoWay}"
                                    OnColor="{StaticResource PrimaryColor}" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="接通后自动开启免提模式"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="自动录音" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding AutoRecorder, Mode=TwoWay}"
                                    OnColor="{StaticResource PrimaryColor}" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="接通后自动开始录音（需录音权限）"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="拨号后自动点呼叫" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding AutoClickCall, Mode=TwoWay}"
                                    OnColor="{StaticResource PrimaryColor}" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="自动拨号时，无障碍服务自动点击呼叫按钮"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="挂断策略" Style="{StaticResource SectionTitle}" Padding="16,16,16,8" />

                    <StackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="未接通自动挂断" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding AutoHangupUnanswered, Mode=TwoWay}"
                                    OnColor="{StaticResource PrimaryColor}" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="超时未接通自动挂断"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto" IsVisible="{Binding AutoHangupUnanswered}">
                            <Label Grid.Row="0" Grid.Column="0" Text="未接通超时（秒）" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding UnansweredTimeout, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="80" HeightRequest="40"
                                   BackgroundColor="{StaticResource PageBackgroundColor}"
                                   TextColor="{StaticResource TextPrimaryColor}" FontSize="14"
                                   HorizontalTextAlignment="End" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="多少秒未接通则判定为无人接听"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource DividerColor}" Margin="16,0" IsVisible="{Binding AutoHangupUnanswered}" />
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="接通后自动挂断" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding AutoHangupAnswered, Mode=TwoWay}"
                                    OnColor="{StaticResource PrimaryColor}" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="通话接通后自动挂断（用于短信验证码类业务）"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,14" RowDefinitions="Auto,Auto" IsVisible="{Binding AutoHangupAnswered}">
                            <Label Grid.Row="0" Grid.Column="0" Text="接通后时长（秒）" FontSize="15"
                                   TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" />
                            <Entry Grid.Row="0" Grid.Column="1" Text="{Binding AnsweredDuration, Mode=TwoWay}"
                                   Keyboard="Numeric" WidthRequest="80" HeightRequest="40"
                                   BackgroundColor="{StaticResource PageBackgroundColor}"
                                   TextColor="{StaticResource TextPrimaryColor}" FontSize="14"
                                   HorizontalTextAlignment="End" Margin="0,0,12,0" />
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="0 表示不限时长，仅标记接通状态"
                                   FontSize="11" TextColor="{StaticResource TextSecondaryColor}" />
                        </Grid>
                    </StackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>