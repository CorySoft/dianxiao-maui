<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:DianxiaoMaui.ViewModels"
             x:Class="DianxiaoMaui.Views.Features.ManualDialPage"
             Title="手动拨号"
             Shell.NavBarIsVisible="True">

    <ContentPage.BindingContext>
        <viewmodel:ManualDialViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="12" Padding="16,16,16,24">
        <Frame Style="{StaticResource CardView}" Padding="0" HasShadow="False" Margin="0">
            <Entry Text="{Binding Number, Mode=TwoWay}"
                   Placeholder="请输入号码"
                   FontSize="22"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TextPrimaryColor}"
                   BackgroundColor="Transparent"
                   HeightRequest="56"
                   Keyboard="Telephone"
                   ClearButtonVisibility="WhileEditing" />
        </Frame>

        <!-- 键盘 -->
        <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*,*,*" RowSpacing="10" ColumnSpacing="10"
              HorizontalOptions="Fill" VerticalOptions="CenterAndExpand">
            <!-- 1 -->
            <Button Grid.Row="0" Grid.Column="0" Text="1" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="1" />
            <!-- 2 -->
            <Button Grid.Row="0" Grid.Column="1" Text="2" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="2" />
            <!-- 3 -->
            <Button Grid.Row="0" Grid.Column="2" Text="3" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="3" />
            <!-- 4 -->
            <Button Grid.Row="1" Grid.Column="0" Text="4" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="4" />
            <!-- 5 -->
            <Button Grid.Row="1" Grid.Column="1" Text="5" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="5" />
            <!-- 6 -->
            <Button Grid.Row="1" Grid.Column="2" Text="6" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="6" />
            <!-- 7 -->
            <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="7" />
            <!-- 8 -->
            <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="8" />
            <!-- 9 -->
            <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="9" />
            <!-- * -->
            <Button Grid.Row="3" Grid.Column="0" Text="*" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="*" />
            <!-- 0 -->
            <Button Grid.Row="3" Grid.Column="1" Text="0" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="0" />
            <!-- # -->
            <Button Grid.Row="3" Grid.Column="2" Text="#" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding KeyCommand}" CommandParameter="#" />
            <!-- 删除 -->
            <Button Grid.Row="4" Grid.Column="0" Text="⌫" Style="{StaticResource DialKeyStyle}"
                    Command="{Binding DeleteCommand}" />
            <!-- 拨打 -->
            <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="拨打"
                    Command="{Binding CallCommand}"
                    BackgroundColor="{StaticResource SuccessColor}"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="28"
                    HeightRequest="56" />
        </Grid>

        <Label Text="拨号后将自动点击呼叫按钮（需开启无障碍服务）。"
               FontSize="12" TextColor="{StaticResource TextSecondaryColor}" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>