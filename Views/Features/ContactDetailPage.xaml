<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:DianxiaoMaui.ViewModels"
             x:Class="DianxiaoMaui.Views.Features.ContactDetailPage"
             Title="客户详情"
             Shell.NavBarIsVisible="True">

    <ContentPage.BindingContext>
        <viewmodel:ContactDetailViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Spacing="0">
        <Frame Style="{StaticResource CardView}" Margin="12,12,12,0" Padding="0">
            <VerticalStackLayout Spacing="12" Padding="16">
                <Label Text="基本信息" Style="{StaticResource SectionTitle}" />

                <Entry Placeholder="姓名" Text="{Binding Customer.Name, Mode=TwoWay}" Style="{StaticResource EntryStyle}" />
                <Entry Placeholder="电话" Text="{Binding Customer.Phone, Mode=TwoWay}" Style="{StaticResource EntryStyle}" Keyboard="Telephone" />
                <Entry Placeholder="标签（逗号分隔）" Text="{Binding Customer.Tags, Mode=TwoWay}" Style="{StaticResource EntryStyle}" />
                <Editor Placeholder="备注" Text="{Binding Customer.Note, Mode=TwoWay}" AutoSize="TextChanges" HeightRequest="80"
                        BackgroundColor="{StaticResource PageBackgroundColor}" TextColor="{StaticResource TextPrimaryColor}" FontSize="13" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="意向等级" FontSize="15" TextColor="{StaticResource TextPrimaryColor}" VerticalOptions="Center" WidthRequest="80" />
                    <Picker Grid.Column="1" ItemsSource="{Binding IntentLevels}"
                            SelectedIndex="{Binding Customer.IntentLevel, Mode=TwoWay}"
                            Title="选择意向"
                            HeightRequest="44"
                            BackgroundColor="{StaticResource CardBackgroundColor}"
                            TextColor="{StaticResource TextPrimaryColor}"
                            FontSize="14" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <Frame Style="{StaticResource CardView}" Margin="12,12,12,0" Padding="0">
            <VerticalStackLayout Spacing="12" Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="该客户通话记录" Style="{StaticResource SectionTitle}" />
                    <Button Grid.Column="1" Text="新增" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddCallLogCommand}" FontSize="12" HeightRequest="32" WidthRequest="60" />
                </Grid>

                <CollectionView ItemsSource="{Binding CallLogs}"
                                EmptyView="暂无通话记录"
                                Margin="0,4,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardView}" Padding="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Column="0" Grid.Row="0" Text="{Binding PhoneNumber}" FontSize="14" TextColor="{StaticResource TextPrimaryColor}" />
                                    <Label Grid.Column="1" Grid.Row="0" Text="{Binding TimeText}" FontSize="12" TextColor="{StaticResource TextSecondaryColor}" HorizontalOptions="End" />
                                    <Label Grid.Column="0" Grid.Row="1" Text="{Binding DurationText}" FontSize="13"
                                           TextColor="{Binding Connected, Converter={StaticResource ConnectedColorConverter}}" />
                                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding ConnectedText}" FontSize="12"
                                           TextColor="{Binding Connected, Converter={StaticResource ConnectedColorConverter}}" HorizontalOptions="End" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Frame>

        <Button Text="保存" Style="{StaticResource PrimaryButton}"
                Command="{Binding SaveCommand}"
                Margin="12,16,12,12" IsVisible="{Binding IsNew}" />
    </VerticalStackLayout>
</ContentPage>